<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-build-only: allows plain HTTP to local dev backends. Android blocks
  cleartext traffic by default since API 28, so without this every request
  from a debug build against a local (non-TLS) backend fails outright - not
  caught by existing tests since they exercise fakes/MockWebServer, never a
  real socket. Release builds have no such override and stay on the default
  (cleartext blocked everywhere), matching production's TLS-via-nginx setup
  (spec 0007 assumption 4 / 0008 assumption 4).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
